  phone         String
  name          String?
  pushName      String?            @map("push_name")
  firstName     String?            @map("first_name")
  fullName      String?            @map("full_name")
  businessName  String?            @map("business_name")
  verifiedName  String?            @map("verified_name")
  profilePicUrl String?            @map("profile_pic_url") @db.Text
  isBusiness    Boolean            @default(false) @map("is_business")
  whatsappLabels String[]          @default([]) @map("whatsapp_labels")
  about         String?            @db.Text
  email         String?
  company       String?
  source        String             @default("whatsapp")
  status        WhatsappLeadStatus @default(new)
  intent        String?            @db.Text
  rubro         String?
  objecion      String?
  datoFaltante  String?            @map("dato_faltante")
  saleOutcome   WhatsappSaleOutcome @default(open) @map("sale_outcome")
