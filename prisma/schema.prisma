// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

enum UserRole {
  USER
  SELLER
  ADMIN
}

enum ReputationColor {
  ROJO       // Más del 10% de reclamos
  NARANJA    // Entre 5% y 10% de reclamos
  AMARILLO   // Entre 2% y 5% de reclamos
  VERDE      // Menos del 2% de reclamos
  VERDE_OSCURO // Sin reclamos, excelente reputación
}

enum SubscriptionTier {
  FREE
  PLATA
  GOLD
  PLATINUM
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  password      String?
  role          UserRole  @default(USER)
  
  // Perfil de vendedor
  isSeller          Boolean   @default(false)
  sellerName        String?
  sellerDescription String?   @db.Text
  sellerSince       DateTime? @map("seller_since")
  
  // Sistema de reputación
  reputationColor   ReputationColor @default(VERDE) @map("reputation_color")
  reputationLevel   String          @default("VENDEDOR NUEVO") @map("reputation_level") // Madslider level
  reputationScore   Float           @default(0) @map("reputation_score") // Puntuación calculada
  
  // Métricas de ventas
  totalSales        Int             @default(0) @map("total_sales")
  successfulSales   Int             @default(0) @map("successful_sales")
  canceledSales     Int             @default(0) @map("canceled_sales")
  totalRevenue      Float           @default(0) @map("total_revenue")
  
  // Métricas de reclamos y disputas
  openClaims        Int             @default(0) @map("open_claims")
  resolvedClaims    Int             @default(0) @map("resolved_claims")
  claimsAgainst     Int             @default(0) @map("claims_against")
  mediaciones       Int             @default(0) @map("mediaciones")
  
  // Métricas de envío
  delayedShipments  Int             @default(0) @map("delayed_shipments")
  onTimeDeliveries  Int             @default(0) @map("on_time_deliveries")
  averageShippingTime Float?        @map("average_shipping_time") // en días
  
  // Métricas de calidad
  claimRate         Float           @default(0) @map("claim_rate") // Porcentaje de reclamos
  cancellationRate  Float           @default(0) @map("cancellation_rate") // Porcentaje de cancelaciones
  delayRate         Float           @default(0) @map("delay_rate") // Porcentaje de envíos demorados
  
  // Tiempo como vendedor
  daysAsSeller      Int?            @map("days_as_seller")
  
  // Suscripción
  subscriptionTier   SubscriptionTier @default(FREE) @map("subscription_tier")
  subscriptionExpiry DateTime?        @map("subscription_expiry")
  
  // Métricas para suscriptores
  monthlyRevenue     Float?   @map("monthly_revenue")
  monthlyViews       Int?     @map("monthly_views")
  conversionRate     Float?   @map("conversion_rate")

  // Clave de acceso adicional (PIN) para acciones sensibles
  accessKey     String? @map("access_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  accounts      Account[]
  sessions      Session[]
  products      Product[]
  orders        Order[]
  reviews       Review[]
  favorites     Favorite[]
  subscriptions Subscription[]
  boosts        ProductBoost[]

  // Nuevas relaciones Fase 1
  questions         Question[]      @relation("BuyerQuestions")
  notifications     Notification[]  @relation("UserNotifications")
  buyerClaims       Claim[]         @relation("BuyerClaims")
  sellerClaims      Claim[]         @relation("SellerClaims")
  claimMessages     ClaimMessage[]
  sentMessages      OrderMessage[]  @relation("SentMessages")
  receivedMessages  OrderMessage[]  @relation("ReceivedMessages")
  campaigns         Campaign[]
  coupons           Coupon[]
  cart              Cart?

  // Reputación
  reputationHistory ReputationHistory[] @relation("ReputationHistory")
  
  // Soporte
  supportTickets    SupportTicket[]     @relation("UserTickets")
  supportMessages   SupportMessage[]    @relation("UserSupportMessages")
  
  @@map("users")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  parentId    String?   @map("parent_id")
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  
  createdAt DateTime @default(now()) @map("created_at")
  
  @@map("categories")
}

model Product {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  price       Float
  comparePrice Float?  @map("compare_price")
  stock       Int      @default(0)
  sku         String?
  condition   String   @default("new") // new, used, refurbished
  
  // Estado
  isActive    Boolean  @default(true) @map("is_active")
  isFeatured  Boolean  @default(false) @map("is_featured")
  isBoosted   Boolean  @default(false) @map("is_boosted")
  boostExpiry DateTime? @map("boost_expiry")
  
  // Métricas
  views       Int      @default(0)
  sales       Int      @default(0)
  
  // Campos para publicaciones tipo Mercado Libre
  originalPrice  Float?    @map("original_price")
  freeShipping   Boolean   @default(false) @map("free_shipping")
  shippingCost   Float     @default(0) @map("shipping_cost")
  qualityScore   Int       @default(0) @map("quality_score")
  hasVideo       Boolean   @default(false) @map("has_video")
  
  // Relaciones
  sellerId    String   @map("seller_id")
  seller      User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  
  categoryId  String   @map("category_id")
  category    Category @relation(fields: [categoryId], references: [id])
  
  images      ProductImage[]
  attributes  ProductAttribute[]
  orderItems  OrderItem[]
  reviews     Review[]
  favorites   Favorite[]
  boosts      ProductBoost[]

  // Nuevas relaciones Fase 1
  questions     Question[]
  variations    ProductVariation[]
  campaignProducts CampaignProduct[]
  cartItems     CartItem[]
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@index([sellerId])
  @@index([categoryId])
  @@index([isActive])
  @@index([isBoosted])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  order     Int     @default(0)
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@map("product_images")
}

model ProductAttribute {
  id        String  @id @default(cuid())
  name      String
  value     String
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@map("product_attributes")
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique @map("order_number")
  status        OrderStatus @default(PENDING)
  
  // Totales
  subtotal      Float
  shippingCost  Float       @default(0) @map("shipping_cost")
  tax           Float       @default(0)
  total         Float
  
  // Dirección de envío
  shippingName      String @map("shipping_name")
  shippingAddress   String @map("shipping_address")
  shippingCity      String @map("shipping_city")
  shippingState     String @map("shipping_state")
  shippingZip       String @map("shipping_zip")
  shippingPhone     String @map("shipping_phone")
  
  // Relaciones
  buyerId       String      @map("buyer_id")
  buyer         User        @relation(fields: [buyerId], references: [id])
  
  items         OrderItem[]
  payment       Payment?
  review        Review?
  
  // Nuevas relaciones Fase 1
  claims        Claim[]
  messages      OrderMessage[]
  shipment        Shipment?
  supportTickets  SupportTicket[]
  
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  
  @@index([buyerId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  quantity  Int
  price     Float   // Precio al momento de la compra
  
  orderId   String  @map("order_id")
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id])
  
  @@map("order_items")
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  items     CartItem[]

  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  quantity  Int      @default(1)
  price     Float    // Precio al momento de agregar al carrito

  cartId    String   @map("cart_id")
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Payment {
  id            String   @id @default(cuid())
  stripeId      String   @unique @map("stripe_id")
  amount        Float
  currency      String   @default("clp")
  status        String
  
  orderId       String   @unique @map("order_id")
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now()) @map("created_at")
  
  @@map("payments")
}

model Review {
  id          String   @id @default(cuid())
  rating      Int      // 1-5 estrellas
  comment     String?  @db.Text

  // Relaciones
  orderId     String   @unique @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  reviewerId  String   @map("reviewer_id")
  reviewer    User     @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now()) @map("created_at")

  @@map("reviews")
}

model Favorite {
  id        String   @id @default(cuid())

  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, productId])
  @@index([userId])
  @@map("favorites")
}

model Subscription {
  id              String           @id @default(cuid())
  tier            SubscriptionTier
  status          String           @default("active") // active, cancelled, expired
  price           Float
  
  // Período
  startDate       DateTime         @map("start_date")
  endDate         DateTime         @map("end_date")
  
  // Stripe
  stripeId        String?          @map("stripe_id")
  stripePriceId   String?          @map("stripe_price_id")
  
  userId          String           @map("user_id")
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime         @default(now()) @map("created_at")
  
  @@index([userId])
  @@map("subscriptions")
}

model ProductBoost {
  id          String   @id @default(cuid())
  cost        Float    // Costo calculado según reputación
  duration    Int      // Días de duración
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  
  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  sellerId    String   @map("seller_id")
  seller      User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  
  stripeId    String?  @map("stripe_id")
  
  createdAt   DateTime @default(now()) @map("created_at")
  
  @@map("product_boosts")
}

model SiteConfig {
  id                    String   @id @default(cuid())
  siteName              String   @default("MarketPlace") @map("site_name")
  siteLogo              String?  @map("site_logo")
  primaryColor          String   @default("#FFE600") @map("primary_color")
  secondaryColor        String   @default("#3483FA") @map("secondary_color")
  
  // Precios de suscripción
  pricePlata            Float    @default(9999) @map("price_plata")
  priceGold             Float    @default(19999) @map("price_gold")
  pricePlatinum         Float    @default(49999) @map("price_platinum")
  
  // Costo base de impulso
  boostBaseCost         Float    @default(9999) @map("boost_base_cost")
  
  // Comisiones
  commissionFree        Float    @default(0.15) @map("commission_free")
  commissionPlata       Float    @default(0.12) @map("commission_plata")
  commissionGold        Float    @default(0.08) @map("commission_gold")
  commissionPlatinum    Float    @default(0.05) @map("commission_platinum")
  
  updatedAt             DateTime @updatedAt @map("updated_at")
  
  @@map("site_config")
}

// ============================================
// NUEVOS MODELOS - FASE 1
// ============================================

// Preguntas y Respuestas
model Question {
  id          String    @id @default(cuid())
  productId   String    @map("product_id")
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  buyerId     String    @map("buyer_id")
  buyer       User      @relation("BuyerQuestions", fields: [buyerId], references: [id], onDelete: Cascade)
  
  question    String    @db.Text
  answer      String?   @db.Text
  answeredAt  DateTime? @map("answered_at")
  answeredBy  String?   @map("answered_by") // seller_id who answered
  
  status      String    @default("pending") // pending, answered
  isPublic    Boolean   @default(true) @map("is_public")
  
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  @@index([productId])
  @@index([buyerId])
  @@index([status])
  @@map("questions")
}

// Notificaciones
model Notification {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  
  type        String   // order, question, claim, message, promotion
  topic       String   // specific sub-topic
  resourceId  String   @map("resource_id") // ID of related entity
  
  title       String
  message     String   @db.Text
  
  isRead      Boolean  @default(false) @map("is_read")
  readAt      DateTime? @map("read_at")
  
  // Webhook data
  webhookUrl  String?  @map("webhook_url")
  webhookSent Boolean  @default(false) @map("webhook_sent")
  
  createdAt   DateTime @default(now()) @map("created_at")
  
  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// Reclamos y Devoluciones
enum ClaimType {
  CLAIM
  RETURN
  EXCHANGE
}

enum ClaimStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
  CANCELLED
}

model Claim {
  id          String      @id @default(cuid())
  
  orderId     String      @map("order_id")
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  buyerId     String      @map("buyer_id")
  buyer       User        @relation("BuyerClaims", fields: [buyerId], references: [id], onDelete: Cascade)
  
  sellerId    String      @map("seller_id")
  seller      User        @relation("SellerClaims", fields: [sellerId], references: [id], onDelete: Cascade)
  
  type        ClaimType   @default(CLAIM)
  reason      String      // damaged, not_as_described, missing_parts, wrong_item, etc.
  description String      @db.Text
  
  status      ClaimStatus @default(OPEN)
  
  // Evidence
  images      String[]    // Array of image URLs
  
  // Resolution
  resolution  String?     // refund, replacement, repair, reject
  resolutionNotes String? @map("resolution_notes") @db.Text
  resolvedAt  DateTime?   @map("resolved_at")
  resolvedBy  String?     @map("resolved_by")
  
  // Refund amount if applicable
  refundAmount Float?     @map("refund_amount")
  
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  
  claimMessages ClaimMessage[]
  
  @@index([orderId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@map("claims")
}

// Mensajes en reclamos
model ClaimMessage {
  id          String   @id @default(cuid())
  
  claimId     String   @map("claim_id")
  claim       Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  
  senderId    String   @map("sender_id")
  sender      User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  
  content     String   @db.Text
  attachments String[] // Array of file URLs
  
  isInternal  Boolean  @default(false) @map("is_internal") // For admin notes
  
  createdAt   DateTime @default(now()) @map("created_at")
  
  @@index([claimId])
  @@index([senderId])
  @@map("claim_messages")
}

// Mensajería Posventa (Chat entre comprador y vendedor)
model OrderMessage {
  id          String   @id @default(cuid())
  
  orderId     String   @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  senderId    String   @map("sender_id")
  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  
  receiverId  String   @map("receiver_id")
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  
  content     String   @db.Text
  attachments String[] // JSON array of file URLs
  
  isRead      Boolean  @default(false) @map("is_read")
  readAt      DateTime? @map("read_at")
  
  createdAt   DateTime @default(now()) @map("created_at")
  
  @@index([orderId])
  @@index([senderId])
  @@index([receiverId])
  @@index([isRead])
  @@map("order_messages")
}

// Tracking de Envíos Detallado
model Shipment {
  id          String   @id @default(cuid())
  
  orderId     String   @unique @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  // Carrier info
  carrier     String   // mercado_envios, fedex, dhl, custom, etc.
  carrierName String?  @map("carrier_name") // Display name
  trackingNumber String? @map("tracking_number")
  
  // Status
  status      String   @default("pending") // pending, ready_to_ship, shipped, in_transit, out_for_delivery, delivered, exception
  
  // Label
  labelUrl    String?  @map("label_url")
  labelGeneratedAt DateTime? @map("label_generated_at")
  
  // Tracking events
  events      ShipmentEvent[]
  
  // Estimated delivery
  estimatedDelivery DateTime? @map("estimated_delivery")
  
  // Actual delivery
  deliveredAt DateTime? @map("delivered_at")
  receivedBy  String?   @map("received_by") // Person who received
  
  // Shipping address (snapshot)
  shippingAddress Json? @map("shipping_address")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@map("shipments")
}

model ShipmentEvent {
  id          String   @id @default(cuid())
  
  shipmentId  String   @map("shipment_id")
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  
  status      String   // Event status code
  description String   // Human readable description
  location    String?  // Where the event occurred
  
  timestamp   DateTime
  
  createdAt   DateTime @default(now()) @map("created_at")
  
  @@index([shipmentId])
  @@index([timestamp])
  @@map("shipment_events")
}

// Variaciones de Producto
model ProductVariation {
  id          String   @id @default(cuid())
  
  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  sku         String?
  
  // Variation attributes (e.g., {"color": "red", "size": "XL"})
  attributes  Json
  
  // Pricing
  price       Float
  comparePrice Float?  @map("compare_price")
  
  // Inventory
  stock       Int      @default(0)
  
  // Images specific to this variation
  images      String[] // Array of image URLs
  
  isActive    Boolean  @default(true) @map("is_active")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@index([productId])
  @@index([sku])
  @@map("product_variations")
}

// Campañas y Promociones
enum CampaignType {
  FLASH_SALE
  DAILY_DEAL
  QUANTITY_DISCOUNT
  COUPON
  PRICE_AGREEMENT
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  PAUSED
  ENDED
  CANCELLED
}

model Campaign {
  id          String         @id @default(cuid())
  
  sellerId    String         @map("seller_id")
  seller      User           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  
  name        String
  description String?        @db.Text
  
  type        CampaignType
  status      CampaignStatus @default(DRAFT)
  
  // Schedule
  startDate   DateTime       @map("start_date")
  endDate     DateTime       @map("end_date")
  
  // Discount
  discountType String        @map("discount_type") // percentage, fixed
  discountValue Float        @map("discount_value")
  
  // For quantity discounts
  minQuantity Int?           @map("min_quantity")
  
  // Budget
  maxBudget   Float?         @map("max_budget")
  spentBudget Float          @default(0) @map("spent_budget")
  
  // Products in campaign
  products    CampaignProduct[]
  
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  
  @@index([sellerId])
  @@index([type])
  @@index([status])
  @@index([startDate])
  @@map("campaigns")
}

model CampaignProduct {
  id          String    @id @default(cuid())
  
  campaignId  String    @map("campaign_id")
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  productId   String    @map("product_id")
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  // Override campaign discount for this product
  discountOverride Float? @map("discount_override")
  
  createdAt   DateTime  @default(now()) @map("created_at")
  
  @@unique([campaignId, productId])
  @@index([productId])
  @@map("campaign_products")
}

// Cupones
model Coupon {
  id          String   @id @default(cuid())
  
  code        String   @unique
  sellerId    String   @map("seller_id")
  seller      User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  
  description String?
  
  // Discount
  discountType String  @map("discount_type") // percentage, fixed
  discountValue Float  @map("discount_value")
  
  // Limits
  minPurchase Float?   @map("min_purchase")
  maxDiscount Float?   @map("max_discount") // For percentage coupons
  
  // Usage limits
  maxUses     Int?     @map("max_uses")
  usedCount   Int      @default(0) @map("used_count")
  maxUsesPerUser Int?  @map("max_uses_per_user")
  // Validity
  startsAt    DateTime @map("starts_at")
  expiresAt   DateTime @map("expires_at")
  
  isBoosted   Boolean   @default(false) @map("is_boosted")
  
  // Reputación y Métricas
  reputationScore Int     @default(0) @map("reputation_score")
  
  @@map("coupons")
}

// Historial de métricas de reputación
model ReputationHistory {
  id          String   @id @default(cuid())
  
  userId      String   @map("user_id")
  user        User     @relation("ReputationHistory", fields: [userId], references: [id], onDelete: Cascade)
  
  // Métricas en este punto del tiempo
  reputationLevel String   @map("reputation_level")
  reputationScore Float   @map("reputation_score")
  reputationColor ReputationColor @map("reputation_color")
  
  // Métricas base
  totalSales        Int    @map("total_sales")
  successfulSales   Int    @map("successful_sales")
  canceledSales     Int    @map("canceled_sales")
  totalRevenue      Float  @map("total_revenue")
  
  // Reclamos y disputas
  openClaims        Int    @map("open_claims")
  resolvedClaims    Int    @map("resolved_claims")
  claimsAgainst     Int    @map("claims_against")
  mediaciones       Int    @map("mediaciones")
  
  // Envíos
  delayedShipments  Int    @map("delayed_shipments")
  onTimeDeliveries  Int    @map("on_time_deliveries")
  
  // Tasas
  claimRate         Float  @map("claim_rate")
  cancellationRate  Float  @map("cancellation_rate")
  delayRate         Float  @map("delay_rate")
  
  // Tiempo como vendedor
  daysAsSeller      Int    @map("days_as_seller")
  
  createdAt         DateTime @default(now()) @map("created_at")
  
  @@index([userId])
  @@index([createdAt])
  @@map("reputation_history")
}

// Configuración de niveles Madslider
model MadsliderLevel {
  id                String  @id @default(cuid())
  
  level             String  @unique // "VENDEDOR NUEVO", "PLATA", etc.
  color             String  // "ROJO", "NARANJA", etc.
  
  // Requisitos mínimos
  minSales          Int     @default(0) @map("min_sales")
  minDaysAsSeller   Int     @default(0) @map("min_days_as_seller")
  minRevenue        Float   @default(0) @map("min_revenue")
  
  // Límites máximos para tasas negativas
  maxClaimRate      Float   @default(1.0) @map("max_claim_rate") // 0.1 = 10%
  maxCancellationRate Float @default(1.0) @map("max_cancellation_rate")
  maxDelayRate      Float   @default(1.0) @map("max_delay_rate")
  
  // Beneficios del nivel
  description       String? @db.Text
  boostDiscount     Float   @default(0) @map("boost_discount") // Porcentaje de descuento en boosts
  
  order             Int     @default(0) // Orden visual
  
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  
  @@map("madslider_levels")
}

// =====================
// SISTEMA DE SOPORTE
// =====================

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_USER
  RESOLVED
  CLOSED
}

enum TicketCategory {
  COMPRAS
  VENTAS
  ENVIOS
  PAGOS
  CUENTA
  RECLAMOS
  OTROS
}

model SupportTicket {
  id          String         @id @default(cuid())
  
  subject     String
  category    TicketCategory @default(OTROS)
  status      TicketStatus   @default(OPEN)
  
  // Relación opcional con orden
  orderId     String?        @map("order_id")
  order       Order?         @relation(fields: [orderId], references: [id])
  
  userId      String         @map("user_id")
  user        User           @relation("UserTickets", fields: [userId], references: [id], onDelete: Cascade)
  
  messages    SupportMessage[]
  
  resolvedAt  DateTime?      @map("resolved_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  
  @@index([userId])
  @@index([status])
  @@map("support_tickets")
}

model SupportMessage {
  id          String   @id @default(cuid())
  
  content     String   @db.Text
  isAgent     Boolean  @default(false) @map("is_agent")
  
  ticketId    String   @map("ticket_id")
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  senderId    String   @map("sender_id")
  sender      User     @relation("UserSupportMessages", fields: [senderId], references: [id])
  
  createdAt   DateTime @default(now()) @map("created_at")
  
  @@index([ticketId])
  @@map("support_messages")
}

model FAQ {
  id          String   @id @default(cuid())
  
  question    String
  answer      String   @db.Text
  category    String   @default("general")
  order       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@map("faqs")
}
