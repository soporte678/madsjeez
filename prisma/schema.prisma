  latencyMs       Int?     @map("latency_ms")
  escalatedTo14b  Boolean  @default(false) @map("escalated_to_14b")
  detectedRubro   String?  @map("detected_rubro")
  detectedIntent  String?  @map("detected_intent")
  detectedStage   String?  @map("detected_stage")
  objection       String?
  reply           String?  @db.Text
  fallbackUsed    Boolean  @default(false) @map("fallback_used")
  errorMessage    String?  @map("error_message")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@index([customerId, createdAt])
  @@index([channel, createdAt])
  @@map("ai_message_logs")
}

model JarvisReport {
  id        String   @id @default(cuid())
  type      String
  scope     String   @default("all")
  summary   String   @db.Text
  body      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([type, createdAt])
  @@map("jarvis_reports")
}

model JarvisFinding {
  id                String   @id @default(cuid())
  scope             String
  severity          String
  title             String
  description       String   @db.Text
  recommendedAction String?  @map("recommended_action") @db.Text
  agentTarget       String?  @map("agent_target")
  status            String   @default("open")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([scope, severity, status])
  @@map("jarvis_findings")
}

model JarvisAgentTask {
  id        String   @id @default(cuid())
  agent     String
  objective String   @db.Text
  filePath  String   @map("file_path")
  status    String   @default("open")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([agent, status, createdAt])
  @@map("jarvis_agent_tasks")
}

model JarvisHealthCheck {
  id        String   @id @default(cuid())
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("jarvis_health_checks")
}

model JarvisVoiceReport {
  id        String   @id @default(cuid())
  text      String   @db.Text
  profile   String   @default("atlas")
  audioUrl  String?  @map("audio_url")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("jarvis_voice_reports")
}

model JarvisAuditLog {
  id        String   @id @default(cuid())
  action    String
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([action, createdAt])
  @@map("jarvis_audit_logs")
}

model JarvisAiLog {
  id                   String   @id @default(cuid())
  command              String?
  scope                String?
  tier                 String
  model                String
  reason               String   @db.Text
  latencyMs            Int      @map("latency_ms")
  escalatedTo14b       Boolean  @default(false) @map("escalated_to_14b")
  promptTokensEstimate Int?     @map("prompt_tokens_estimate")
  createdAt            DateTime @default(now()) @map("created_at")

  @@index([command, createdAt])
  @@index([tier, createdAt])
  @@map("jarvis_ai_logs")
}

// ============================================
// MODELOS DE AUDITORÍA Y ANALYTICS
// ============================================

// Historial de precios de productos
model PriceHistory {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  oldPrice  Decimal  @map("old_price") @db.Decimal(12, 2)
  newPrice  Decimal  @map("new_price") @db.Decimal(12, 2)
  changedBy String?  @map("changed_by") // userId o 'system'
  reason    String?  // motivo del cambio
  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId, createdAt])
  @@map("price_history")
}

// Auditoría de cambios críticos
model AuditLog {
  id         String   @id @default(cuid())
  action     String   // 'CREATE', 'UPDATE', 'DELETE', 'LOGIN', etc.
  entityType String   @map("entity_type") // 'Product', 'Order', 'User', etc.
  entityId   String   @map("entity_id")
  userId     String?  @map("user_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_log")
}

// Vistas de productos (analytics)
model ProductView {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  userId    String?  @map("user_id") // null = usuario anónimo
  ipAddress String?  @map("ip_address")
  source    String?  // 'search', 'category', 'direct', 'recommendation'
  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId, createdAt])
  @@index([createdAt])
  @@map("product_views")
}

