  hot
  customer
  closed
  lost
}

enum WhatsappConversationStatus {
  bot_active
  human_active
  closed
}

enum WhatsappMessageDirection {
  inbound
  outbound
}

enum WhatsappMessageSenderType {
  customer
  bot
  seller
  system
}

enum WhatsappMessageType {
  text
  image
  audio
  file
  location
}

enum WhatsappHandoffStatus {
  requested
  accepted
  resolved
}

enum WhatsappCampaignStatus {
  draft
  scheduled
  running
  paused
  finished
}

enum WhatsappMessageSource {
  webhook
  history_sync
  manual
  bot
}

enum WhatsappSyncJobType {
  contacts
  chats
  messages
  full
}

enum WhatsappSyncJobStatus {
  pending
