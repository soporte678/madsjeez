  question    String
  answer      String   @db.Text
  category    String   @default("general")
  order       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@map("faqs")
}

// ============================================
// SISTEMA FLASH — LOGÍSTICA PROPIA
// ============================================

enum FlashShipmentStatus {
  CREATED
  PAYMENT_CONFIRMED
  LABEL_GENERATED
  PACKAGE_READY
  AVAILABLE
  ACCEPTED_BY_DRIVER
  DRIVER_EN_ROUTE_TO_PICKUP
  PACKAGE_PICKED_UP
  ASSIGNED_TO_DRIVER
  IN_TRANSIT
  ARRIVED_AT_ADDRESS
  DELIVERED
  FAILED_ATTEMPT_1
  PENDING_VISIT_2
  FAILED_ATTEMPT_2
  PENDING_VISIT_3
  FAILED_ATTEMPT_3
  RETURNED_TO_SENDER
  RETURNED_TO_SELLER
  CANCELLED
}

enum FlashReceiverType {
  TITULAR
  AUTHORIZED
  FAMILY
  NEIGHBOR
}

enum FlashAttemptStatus {
  IN_PROGRESS
  DELIVERED
  CLIENT_NOT_FOUND
}

model FlashShipment {
  id               String               @id @default(cuid())
  orderId          String               @unique @map("order_id")
  order            Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Datos del destinatario
  recipientName    String               @map("recipient_name")
  recipientDni     String               @map("recipient_dni")
  recipientPhone   String               @map("recipient_phone")

  // Dirección completa
  street           String
  streetNumber     String               @map("street_number")
  floor            String?
  apartment        String?
  betweenStreet1   String               @map("between_street1")
  betweenStreet2   String               @map("between_street2")
  city             String
  province         String
  postalCode       String               @map("postal_code")

  // Control operativo
  status           FlashShipmentStatus  @default(CREATED)
  driverId         String?              @map("driver_id")
  driver           FlashDriver?         @relation(fields: [driverId], references: [id], onDelete: SetNull)
  labelUrl         String?              @map("label_url")
  qrToken          String               @unique @map("qr_token")
  labelPrintCount  Int                  @default(0) @map("label_print_count")

  // Tier de envío Flash (flash_local, flash_plus, flash_normal)
  shippingTier     String?              @map("shipping_tier")
  shippingPrice    Decimal?             @map("shipping_price") @db.Decimal(12, 2)
  priorityScore    Int                  @default(50) @map("priority_score")

  // Pago del envío al conductor
  paymentStatus    String               @default("pending") @map("payment_status") // pending | paid_by_customer | driver_assigned | ready_to_settle | settled_to_driver | failed | refunded | cancelled
  settlementId     String?              @unique @map("settlement_id")
  settlement       FlashDriverSettlement? @relation("ShipmentSettlement")

  // Estimado de entrega
  estimatedDelivery DateTime?           @map("estimated_delivery")

  attempts         FlashDeliveryAttempt[]
  authorizedPeople FlashAuthorizedRecipient[]
  deliveryProof    FlashDeliveryProof?
  auditLogs        FlashAuditLog[]

  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([driverId])
  @@index([status])
  @@map("flash_shipments")
}

enum FlashDriverDutyStatus {
  OFFLINE
  ONLINE
  ON_TRIP
  ON_BREAK
}

enum FlashDriverTier {
  BRONZE
  SILVER
  GOLD
  DIAMOND
}

enum FlashEarningStatus {
  PENDING
  PROCESSING
  PAID
}

enum FlashSupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum FlashBlockStatus {
  AVAILABLE
  RESERVED
  ACTIVE
  COMPLETED
  CANCELLED
}

model FlashDriver {
  id            String                @id @default(cuid())
  userId        String                @unique @map("user_id")
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType   String                @default("moto") @map("vehicle_type")
  licenseNumber String?               @map("license_number")
  phone         String
  isActive      Boolean               @default(true) @map("is_active")

  dutyStatus    FlashDriverDutyStatus @default(OFFLINE) @map("duty_status")
  workMode      String                @default("hybrid") @map("work_mode") // hybrid | blocks | on_demand
  rating        Float                 @default(5)
