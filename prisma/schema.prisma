// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model AdminSession {
  id               String    @id @default(cuid())
  adminUserId      String    @map("admin_user_id")
  userId           String    @map("user_id")
  email            String
  sessionTokenHash String    @unique @map("session_token_hash")
  userAgent        String?   @map("user_agent") @db.Text
  ipAddress        String?   @map("ip_address")
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([adminUserId, revokedAt, expiresAt])
  @@index([userId, revokedAt, expiresAt])
  @@map("admin_sessions")
}

enum UserRole {
  USER
  SELLER
  ADMIN
}

enum ReputationColor {
  ROJO       // Más del 10% de reclamos
  NARANJA    // Entre 5% y 10% de reclamos
  AMARILLO   // Entre 2% y 5% de reclamos
  VERDE      // Menos del 2% de reclamos
  VERDE_OSCURO // Sin reclamos, excelente reputación
}

enum SubscriptionTier {
  FREE
  PLATA
  GOLD
  PLATINUM
}

enum MeliAdsChangeOutcome {
  PENDING
  POSITIVE
  NEGATIVE
  NEUTRAL
}

enum SellerCollaboratorInviteStatus {
  PENDING
  REVOKED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  password      String?
  role          UserRole  @default(USER)
  
  // Perfil de vendedor
  isSeller          Boolean   @default(false)
  sellerName        String?
  sellerDescription String?   @db.Text
  sellerSince       DateTime? @map("seller_since")
  /// URL pública /tienda/[storeSlug]
  storeSlug         String?   @unique @map("store_slug")
  
  // Sistema de reputación
  reputationColor   ReputationColor @default(VERDE) @map("reputation_color")
  reputationLevel   String          @default("VENDEDOR NUEVO") @map("reputation_level") // Madslider level
  reputationScore   Float           @default(0) @map("reputation_score") // Puntuación calculada
  
  // Métricas de ventas
  totalSales        Int             @default(0) @map("total_sales")
  successfulSales   Int             @default(0) @map("successful_sales")
  canceledSales     Int             @default(0) @map("canceled_sales")
  totalRevenue      Decimal         @default(0) @db.Decimal(15, 2) @map("total_revenue")
  
  // Métricas de reclamos y disputas
  openClaims        Int             @default(0) @map("open_claims")
  resolvedClaims    Int             @default(0) @map("resolved_claims")
  claimsAgainst     Int             @default(0) @map("claims_against")
  mediaciones       Int             @default(0) @map("mediaciones")
  
  // Métricas de envío
  delayedShipments  Int             @default(0) @map("delayed_shipments")
  onTimeDeliveries  Int             @default(0) @map("on_time_deliveries")
  averageShippingTime Float?        @map("average_shipping_time") // en días
  
  // Métricas de calidad
  claimRate         Float           @default(0) @map("claim_rate") // Porcentaje de reclamos
  cancellationRate  Float           @default(0) @map("cancellation_rate") // Porcentaje de cancelaciones
  delayRate         Float           @default(0) @map("delay_rate") // Porcentaje de envíos demorados
  
  // Tiempo como vendedor
  daysAsSeller      Int?            @map("days_as_seller")
  
  // Suscripción
  subscriptionTier   SubscriptionTier @default(FREE) @map("subscription_tier")
  subscriptionExpiry DateTime?        @map("subscription_expiry")
  
  // Métricas para suscriptores
  monthlyRevenue     Decimal? @map("monthly_revenue") @db.Decimal(15, 2)
  monthlyViews       Int?     @map("monthly_views")
  conversionRate     Float?   @map("conversion_rate")

  // Clave de acceso adicional (PIN) para acciones sensibles
  accessKey     String? @map("access_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  accounts      Account[]
  sessions      Session[]
  products      Product[]
  orders        Order[]
  reviews       Review[]
  favorites     Favorite[]
  subscriptions Subscription[]
  boosts        ProductBoost[]

  // Nuevas relaciones Fase 1
  questions         Question[]      @relation("BuyerQuestions")
  notifications     Notification[]  @relation("UserNotifications")
  buyerClaims       Claim[]         @relation("BuyerClaims")
  sellerClaims      Claim[]         @relation("SellerClaims")
  claimMessages     ClaimMessage[]
  sentMessages      OrderMessage[]  @relation("SentMessages")
  receivedMessages  OrderMessage[]  @relation("ReceivedMessages")
  campaigns         Campaign[]
  coupons           Coupon[]
  cart              Cart?
  // Flash
  flashDriver       FlashDriver?
  sellerMeliOAuthAccounts SellerMeliOAuth[]
  sellerZipnovaOAuth SellerZipnovaOAuth?
  meliAdsSnapshots  MeliAdsSnapshot[]
  meliAdsChanges    MeliAdsChange[]
  collaboratorInvitesSent SellerCollaboratorInvite[] @relation("CollaboratorInvitesSent")
  collaboratorAccountsOwned SellerCollaborator[]      @relation("CollaboratorAccountsOwned")
  collaboratorMemberships SellerCollaborator[]      @relation("CollaboratorMemberships")
  sellerInvitesOwned SellerInvite[]
  sellerLeadProfile  SellerLead?

  // WhatsApp Seller AI Bot (Evolution / multi-tenant por vendedor)
  whatsappSessions     WhatsappSession[]
  sellerBotConfig      SellerBotConfig?
  whatsappLeads        WhatsappLead[]
  whatsappConversations WhatsappConversation[]
  whatsappBotEvents    WhatsappBotEvent[]
  whatsappAutomations  WhatsappAutomation[]
  whatsappCampaigns    WhatsappCampaign[]
  whatsappSyncJobs     WhatsappSyncJob[]
  whatsappCloserDecisions WhatsappCloserDecision[]
  whatsappWinningResponses WhatsappWinningResponse[]

  // Reputación
  reputationHistory ReputationHistory[] @relation("ReputationHistory")
  
  // Soporte
  supportTickets    SupportTicket[]     @relation("UserTickets")
  supportMessages   SupportMessage[]    @relation("UserSupportMessages")
  
  // Índices optimizados para consultas frecuentes
  @@index([isSeller])                    // Para queries de vendedores
  @@index([storeSlug])                   // Para páginas de tienda
  @@index([reputationColor])             // Para filtros de reputación
  @@map("users")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  parentId    String?   @map("parent_id")
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  meliCategoryId String? @unique @map("meli_category_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("categories")
}

model Product {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  price       Decimal  @db.Decimal(12, 2)
  comparePrice Decimal? @db.Decimal(12, 2)  @map("compare_price")
  stock       Int      @default(0)
  sku         String?
  condition   String   @default("new") // new, used, refurbished
  
  // Estado
  isActive    Boolean  @default(true) @map("is_active")
  isFeatured  Boolean  @default(false) @map("is_featured")
  isBoosted   Boolean  @default(false) @map("is_boosted")
  boostExpiry DateTime? @map("boost_expiry")
  
  // Métricas
  views       Int      @default(0)
  sales       Int      @default(0)
  
  // Campos para publicaciones tipo Mercado Libre
  originalPrice  Decimal? @db.Decimal(12, 2)    @map("original_price")
  freeShipping   Boolean   @default(false) @map("free_shipping")
  shippingCost   Decimal   @default(0) @db.Decimal(12, 2) @map("shipping_cost")
  qualityScore   Int       @default(0) @map("quality_score")
  hasVideo       Boolean   @default(false) @map("has_video")
  
  // Relaciones
  sellerId    String   @map("seller_id")
  seller      User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  
  categoryId  String   @map("category_id")
  category    Category @relation(fields: [categoryId], references: [id])
  
  images      ProductImage[]
  attributes  ProductAttribute[]
  orderItems  OrderItem[]
  reviews     Review[]
  favorites   Favorite[]
  boosts      ProductBoost[]

  // Nuevas relaciones Fase 1
  questions     Question[]
  variations    ProductVariation[]
  campaignProducts CampaignProduct[]
  cartItems     CartItem[]

  /// ID publicación MLA/MLM/etc. en Mercado Libre (importación)
  meliItemId  String? @unique @map("meli_item_id")
  meliOAuthAccountId String? @map("meli_oauth_account_id")
  meliOAuthAccount   SellerMeliOAuth? @relation(fields: [meliOAuthAccountId], references: [id], onDelete: SetNull)
  meliCategoryId     String? @map("meli_category_id")
  meliListingTypeId  String? @map("meli_listing_type_id")
  meliStatus         String? @map("meli_status")
  meliPermalink      String? @map("meli_permalink")
  meliCurrencyId     String? @default("ARS") @map("meli_currency_id")
  meliPayload        Json?   @map("meli_payload")
  meliLastSyncedAt   DateTime? @map("meli_last_synced_at")
  meliStockSyncEnabled Boolean @default(true) @map("meli_stock_sync_enabled")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([sellerId])
  @@index([categoryId])
  @@index([isActive])
  @@index([isBoosted])
  @@index([meliOAuthAccountId])
  // Índices optimizados para consultas frecuentes
  @@index([isActive, stock, createdAt])  // Para listados públicos ordenados
  @@index([sellerId, isActive])          // Para dashboards de vendedor
  @@index([categoryId, isActive])        // Para páginas de categoría
  @@index([title])                       // Para búsquedas (recomendado: cambiar a pg_trgm)
  @@index([createdAt])                   // Para ordenamiento general
  @@map("products")
}

/// OAuth Mercado Libre — varias cuentas ML por vendedor Madsjeez
model SellerMeliOAuth {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  meliUserId   String   @map("meli_user_id")
  nickname     String?  @map("nickname")
  label        String?  @map("label")
  isPrimary    Boolean  @default(false) @map("is_primary")
  accessToken  String   @db.Text @map("access_token")
  refreshToken String?  @db.Text @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  lastCatalogImportAt DateTime? @map("last_catalog_import_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  products     Product[]

  @@unique([userId, meliUserId])
  @@index([userId])
  @@map("seller_meli_oauth")
}

/// OAuth Zipnova Envíos por vendedor (integración marketplace multi-cuenta).
model SellerZipnovaOAuth {
  id               String   @id @default(cuid())
  userId           String   @unique @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken      String   @db.Text @map("access_token")
  refreshToken     String?  @db.Text @map("refresh_token")
  expiresAt        DateTime @map("expires_at")
  scope            String?  @db.Text
  zipnovaAccountId Int?     @map("zipnova_account_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("seller_zipnova_oauth")
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  order     Int     @default(0)
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@index([productId, order])            // Para carga ordenada de imágenes
  @@map("product_images")
}

model ProductAttribute {
  id        String  @id @default(cuid())
  name      String
  value     String
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@map("product_attributes")
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique @map("order_number")
  status        OrderStatus @default(PENDING)
  
  // Totales
  subtotal      Decimal @db.Decimal(12, 2)
  shippingCost  Decimal     @default(0) @db.Decimal(12, 2) @map("shipping_cost")
  tax           Decimal     @default(0) @db.Decimal(12, 2)
  total         Decimal @db.Decimal(12, 2)
  
  // Dirección de envío
  shippingName      String @map("shipping_name")
  shippingAddress   String @map("shipping_address")
  shippingCity      String @map("shipping_city")
  shippingState     String @map("shipping_state")
  shippingZip       String @map("shipping_zip")
  shippingPhone     String @map("shipping_phone")
  
  // Relaciones
  buyerId       String      @map("buyer_id")
  buyer         User        @relation(fields: [buyerId], references: [id])
  
  items         OrderItem[]
  payment       Payment?
  review        Review?
  
  // Nuevas relaciones Fase 1
  claims        Claim[]
  messages      OrderMessage[]
  shipment        Shipment?
  flashShipment   FlashShipment?
  supportTickets  SupportTicket[]
  
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  
  @@index([buyerId])
  // Índices optimizados para consultas frecuentes
  @@index([buyerId, status, createdAt])  // Para "mis compras"
  @@index([status, createdAt])           // Para queries admin
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  quantity  Int
  price     Decimal @db.Decimal(12, 2) // Precio al momento de la compra
  
  orderId   String  @map("order_id")
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id])
  
  @@index([orderId])                     // Para joins
  @@index([productId])                   // Para analytics de productos
  @@map("order_items")
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique @map("user_id")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  items     CartItem[]

  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  quantity  Int      @default(1)
  price     Decimal  @db.Decimal(12, 2) // Precio al momento de agregar al carrito

  cartId    String   @map("cart_id")
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Payment {
  id            String   @id @default(cuid())
  stripeId      String   @unique @map("stripe_id")
  amount        Decimal @db.Decimal(12, 2)
  currency      String   @default("clp")
  status        String
  
  orderId       String   @unique @map("order_id")
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now()) @map("created_at")
  
  @@map("payments")
}

model Review {
  id          String   @id @default(cuid())
  rating      Int      // 1-5 estrellas
  comment     String?  @db.Text

  // Relaciones
  orderId     String   @unique @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  reviewerId  String   @map("reviewer_id")
  reviewer    User     @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now()) @map("created_at")

  @@index([productId, createdAt])        // Para reviews en página de producto
  @@index([reviewerId])                  // Para reputación del vendedor
  @@map("reviews")
}

model Favorite {
  id        String   @id @default(cuid())

  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, productId])
  @@index([userId])
  @@map("favorites")
}

model Subscription {
  id              String           @id @default(cuid())
  tier            SubscriptionTier
  status          String           @default("active") // active, cancelled, expired
  price           Decimal          @db.Decimal(12, 2) // Precio base mensual
  
  // Ciclo de facturación (1, 6 o 12 meses)
  billingCycle    Int              @default(1) @map("billing_cycle")
  totalAmount     Decimal          @map("total_amount") @db.Decimal(12, 2) // Monto total con descuento aplicado
  discountPercent Float            @default(0) @map("discount_percent") // Porcentaje de descuento aplicado (0, 20, 30)
  
  // Período
  startDate       DateTime         @map("start_date")
  endDate         DateTime         @map("end_date")
  
  // Stripe
  stripeId        String?          @map("stripe_id")
  stripePriceId   String?          @map("stripe_price_id")
  
  // MercadoPago
  mpPreferenceId  String?          @map("mp_preference_id")
  mpPaymentId     String?          @map("mp_payment_id")
  mpStatus        String?          @map("mp_status")
  
  userId          String           @map("user_id")
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime         @default(now()) @map("created_at")
  
  @@index([userId])
  @@map("subscriptions")
}

model ProductBoost {
  id          String   @id @default(cuid())
  cost        Decimal  @db.Decimal(12, 2) // Costo calculado según reputación
  duration    Int      // Días de duración
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  
  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  sellerId    String   @map("seller_id")
  seller      User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  
  stripeId    String?  @map("stripe_id")
  
  createdAt   DateTime @default(now()) @map("created_at")
  
  @@map("product_boosts")
}

model SiteConfig {
  id                    String   @id @default(cuid())
  siteName              String   @default("MarketPlace") @map("site_name")
  siteLogo              String?  @map("site_logo")
  primaryColor          String   @default("#FFE600") @map("primary_color")
  secondaryColor        String   @default("#3483FA") @map("secondary_color")
  
  // Precios de suscripción
  pricePlata            Decimal  @default(9999) @db.Decimal(12, 2) @map("price_plata")
  priceGold             Decimal  @default(19999) @db.Decimal(12, 2) @map("price_gold")
  pricePlatinum         Decimal  @default(49999) @db.Decimal(12, 2) @map("price_platinum")
  
  // Costo base de impulso
  boostBaseCost         Decimal  @default(9999) @db.Decimal(12, 2) @map("boost_base_cost")
  
  // Comisiones
  commissionFree        Float    @default(0.15) @map("commission_free")
  commissionPlata       Float    @default(0.12) @map("commission_plata")
  commissionGold        Float    @default(0.08) @map("commission_gold")
  commissionPlatinum    Float    @default(0.05) @map("commission_platinum")
  
  updatedAt             DateTime @updatedAt @map("updated_at")
  
  @@map("site_config")
}

// ============================================
// NUEVOS MODELOS - FASE 1
// ============================================

// Preguntas y Respuestas
model Question {
  id          String    @id @default(cuid())
  productId   String    @map("product_id")
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  buyerId     String    @map("buyer_id")
  buyer       User      @relation("BuyerQuestions", fields: [buyerId], references: [id], onDelete: Cascade)
  
  question    String    @db.Text
  answer      String?   @db.Text
  answeredAt  DateTime? @map("answered_at")
  answeredBy  String?   @map("answered_by") // seller_id who answered
  
  // Imágenes adjuntas (máximo 2) - solo visibles para el vendedor
  images      String[]  @default([]) // URLs de imágenes en Supabase Storage
  
  status      String    @default("pending") // pending, answered
  isPublic    Boolean   @default(true) @map("is_public")
  
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  @@index([productId])
  @@index([buyerId])
  @@index([status])
  // Índices optimizados para consultas frecuentes
  @@index([productId, createdAt])        // Para preguntas en página de producto
  @@index([answeredBy, status])          // Para panel de preguntas del vendedor (answeredBy = seller)
  @@map("questions")
}

// Notificaciones
model Notification {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  
  type        String   // order, question, claim, message, promotion
  topic       String   // specific sub-topic
  resourceId  String   @map("resource_id") // ID of related entity
  
  title       String
  message     String   @db.Text
  
  isRead      Boolean  @default(false) @map("is_read")
  readAt      DateTime? @map("read_at")
  
  // Webhook data
  webhookUrl  String?  @map("webhook_url")
  webhookSent Boolean  @default(false) @map("webhook_sent")
  
  createdAt   DateTime @default(now()) @map("created_at")
  
  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
  // Índice compuesto optimizado
  @@index([userId, isRead, createdAt])   // Para "mis notificaciones"
  @@map("notifications")
}

// Reclamos y Devoluciones
enum ClaimType {
  CLAIM
  RETURN
  EXCHANGE
}

enum ClaimStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
  CANCELLED
}

model Claim {
  id          String      @id @default(cuid())
  
  orderId     String      @map("order_id")
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  buyerId     String      @map("buyer_id")
  buyer       User        @relation("BuyerClaims", fields: [buyerId], references: [id], onDelete: Cascade)
  
  sellerId    String      @map("seller_id")
  seller      User        @relation("SellerClaims", fields: [sellerId], references: [id], onDelete: Cascade)
  
  type        ClaimType   @default(CLAIM)
  reason      String      // damaged, not_as_described, missing_parts, wrong_item, etc.
  description String      @db.Text
  
  status      ClaimStatus @default(OPEN)
  
  // Evidence
  images      String[]    // Array of image URLs
  
  // Resolution
  resolution  String?     // refund, replacement, repair, reject
  resolutionNotes String? @map("resolution_notes") @db.Text
  resolvedAt  DateTime?   @map("resolved_at")
  resolvedBy  String?     @map("resolved_by")
  
  // Refund amount if applicable
  refundAmount Decimal?   @map("refund_amount") @db.Decimal(12, 2)
  
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  
  claimMessages ClaimMessage[]
  
  @@index([orderId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@map("claims")
}

// Mensajes en reclamos
model ClaimMessage {
  id          String   @id @default(cuid())
  
  claimId     String   @map("claim_id")
  claim       Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  
  senderId    String   @map("sender_id")
  sender      User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  
  content     String   @db.Text
  attachments String[] // Array of file URLs
  
  isInternal  Boolean  @default(false) @map("is_internal") // For admin notes
  
  createdAt   DateTime @default(now()) @map("created_at")
  
  @@index([claimId])
  @@index([senderId])
  @@map("claim_messages")
}

// Mensajería Posventa (Chat entre comprador y vendedor)
model OrderMessage {
  id          String   @id @default(cuid())
  
  orderId     String   @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  senderId    String   @map("sender_id")
  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  
  receiverId  String   @map("receiver_id")
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  
  content     String   @db.Text
  attachments String[] // JSON array of file URLs
  
  isRead      Boolean  @default(false) @map("is_read")
  readAt      DateTime? @map("read_at")
  
  createdAt   DateTime @default(now()) @map("created_at")
  
  @@index([orderId])
  @@index([senderId])
  @@index([receiverId])
  @@index([isRead])
  @@map("order_messages")
}

// Tracking de Envíos Detallado
model Shipment {
  id          String   @id @default(cuid())
  
  orderId     String   @unique @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  // Carrier info
  carrier     String   // mercado_envios, fedex, dhl, custom, etc.
  carrierName String?  @map("carrier_name") // Display name
  trackingNumber String? @map("tracking_number")
  
  // Status
  status      String   @default("pending") // pending, ready_to_ship, shipped, in_transit, out_for_delivery, delivered, exception
  
  // Label
  labelUrl    String?  @map("label_url")
  labelGeneratedAt DateTime? @map("label_generated_at")
  
  // Tracking events
  events      ShipmentEvent[]
  
  // Estimated delivery
  estimatedDelivery DateTime? @map("estimated_delivery")
  
  // Actual delivery
  deliveredAt DateTime? @map("delivered_at")
  receivedBy  String?   @map("received_by") // Person who received
  
  // Shipping address (snapshot)
  shippingAddress Json? @map("shipping_address")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@map("shipments")
}

model ShipmentEvent {
  id          String   @id @default(cuid())
  
  shipmentId  String   @map("shipment_id")
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  
  status      String   // Event status code
  description String   // Human readable description
  location    String?  // Where the event occurred
  
  timestamp   DateTime
  
  createdAt   DateTime @default(now()) @map("created_at")
  
  @@index([shipmentId])
  @@index([timestamp])
  @@map("shipment_events")
}

// Variaciones de Producto
model ProductVariation {
  id          String   @id @default(cuid())
  
  productId   String   @map("product_id")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  sku         String?
  
  // Variation attributes (e.g., {"color": "red", "size": "XL"})
  attributes  Json
  
  // Pricing
  price       Decimal  @db.Decimal(12, 2)
  comparePrice Decimal? @db.Decimal(12, 2)  @map("compare_price")
  
  // Inventory
  stock       Int      @default(0)
  
  // Images specific to this variation
  images      String[] // Array of image URLs
  meliVariationId String? @unique @map("meli_variation_id")

  isActive    Boolean  @default(true) @map("is_active")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@index([productId])
  @@index([sku])
  @@map("product_variations")
}

// Campañas y Promociones
enum CampaignType {
  FLASH_SALE
  DAILY_DEAL
  QUANTITY_DISCOUNT
  COUPON
  PRICE_AGREEMENT
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  PAUSED
  ENDED
  CANCELLED
}

enum InternalAdPlacement {
  HOME_LEADERBOARD
  HOME_RECTANGLE
  HOME_TILE
  CATEGORY_LEADERBOARD
  SEARCH_INLINE
}

enum InternalAdPricingModel {
  SOV
  CPM
  CPC
}

enum InternalAdEventType {
  IMPRESSION
  CLICK
}

model Campaign {
  id          String         @id @default(cuid())
  
  sellerId    String         @map("seller_id")
  seller      User           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  
  name        String
  description String?        @db.Text
  
  type        CampaignType
  status      CampaignStatus @default(DRAFT)
  
  // Schedule
  startDate   DateTime       @map("start_date")
  endDate     DateTime       @map("end_date")
  
  // Discount
  discountType String        @map("discount_type") // percentage, fixed
  discountValue Decimal      @map("discount_value") @db.Decimal(12, 2)
  
  // For quantity discounts
  minQuantity Int?           @map("min_quantity")
  
  // Budget
  maxBudget   Decimal?       @map("max_budget") @db.Decimal(12, 2)
  spentBudget Decimal        @default(0) @map("spent_budget") @db.Decimal(12, 2)
  
  // Products in campaign
  products    CampaignProduct[]
  internalAd  InternalAdCampaign?

  /// Promoción origen Mercado Libre (si se sincronizó desde ML)
  meliPromotionId String? @map("meli_promotion_id")
  
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  
  @@index([sellerId])
  @@index([type])
  @@index([status])
  @@index([startDate])
  @@unique([sellerId, meliPromotionId])
  @@map("campaigns")
}

model CampaignProduct {
  id          String    @id @default(cuid())
  
  campaignId  String    @map("campaign_id")
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  productId   String    @map("product_id")
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  // Override campaign discount for this product
  discountOverride Decimal? @db.Decimal(12, 2) @map("discount_override")
  
  createdAt   DateTime  @default(now()) @map("created_at")
  
  @@unique([campaignId, productId])
  @@index([productId])
  @@map("campaign_products")
}

model InternalAdCampaign {
  id                      String                 @id @default(cuid())
  campaignId              String                 @unique @map("campaign_id")
  campaign                Campaign               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  placement               InternalAdPlacement
  pricingModel            InternalAdPricingModel @default(SOV) @map("pricing_model")
  shareOfVoice            Int?                   @map("share_of_voice")
  bannerTitle             String?                @map("banner_title")
  bannerSubtitle          String?                @map("banner_subtitle")
  bannerImageUrl          String?                @map("banner_image_url")
  destinationUrl          String?                @map("destination_url")
  rotationIntervalSeconds Int                    @default(60) @map("rotation_interval_seconds")
  isActive                Boolean                @default(true) @map("is_active")
  events                  InternalAdEvent[]
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")

  @@index([placement, isActive])
  @@map("internal_ad_campaigns")
}

model InternalAdEvent {
  id                  String              @id @default(cuid())
  internalAdCampaignId String             @map("internal_ad_campaign_id")
  internalAdCampaign  InternalAdCampaign  @relation(fields: [internalAdCampaignId], references: [id], onDelete: Cascade)
  eventType           InternalAdEventType @map("event_type")
  slotKey             String?             @map("slot_key")
  pagePath            String?             @map("page_path")
  visitorHash         String?             @map("visitor_hash")
  createdAt           DateTime            @default(now()) @map("created_at")

  @@index([internalAdCampaignId, eventType])
  @@index([pagePath, createdAt])
  @@map("internal_ad_events")
}

// Cupones
model Coupon {
  id          String   @id @default(cuid())
  
  code        String   @unique
  sellerId    String   @map("seller_id")
  seller      User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  
  description String?
  
  // Discount
  discountType String  @map("discount_type") // percentage, fixed
  discountValue Decimal @db.Decimal(12, 2) @map("discount_value")
  
  // Limits
  minPurchase Decimal? @db.Decimal(12, 2) @map("min_purchase")
  maxDiscount Decimal? @db.Decimal(12, 2) @map("max_discount") // For percentage coupons
  
  // Usage limits
  maxUses     Int?     @map("max_uses")
  usedCount   Int      @default(0) @map("used_count")
  maxUsesPerUser Int?  @map("max_uses_per_user")
  // Validity
  startsAt    DateTime @map("starts_at")
  expiresAt   DateTime @map("expires_at")
  
  isBoosted   Boolean   @default(false) @map("is_boosted")
  
  // Reputación y Métricas
  reputationScore Int     @default(0) @map("reputation_score")
  
  @@index([code])                        // Búsqueda por código
  @@index([expiresAt])                   // Para validación de vigencia
  @@map("coupons")
}

// Historial de métricas de reputación
model ReputationHistory {
  id          String   @id @default(cuid())
  
  userId      String   @map("user_id")
  user        User     @relation("ReputationHistory", fields: [userId], references: [id], onDelete: Cascade)
  
  // Métricas en este punto del tiempo
  reputationLevel String   @map("reputation_level")
  reputationScore Float   @map("reputation_score")
  reputationColor ReputationColor @map("reputation_color")
  
  // Métricas base
  totalSales        Int    @map("total_sales")
  successfulSales   Int    @map("successful_sales")
  canceledSales     Int    @map("canceled_sales")
  totalRevenue      Decimal @db.Decimal(15, 2) @map("total_revenue")
  
  // Reclamos y disputas
  openClaims        Int    @map("open_claims")
  resolvedClaims    Int    @map("resolved_claims")
  claimsAgainst     Int    @map("claims_against")
  mediaciones       Int    @map("mediaciones")
  
  // Envíos
  delayedShipments  Int    @map("delayed_shipments")
  onTimeDeliveries  Int    @map("on_time_deliveries")
  
  // Tasas
  claimRate         Float  @map("claim_rate")
  cancellationRate  Float  @map("cancellation_rate")
  delayRate         Float  @map("delay_rate")
  
  // Tiempo como vendedor
  daysAsSeller      Int    @map("days_as_seller")
  
  createdAt         DateTime @default(now()) @map("created_at")
  
  @@index([userId])
  @@index([createdAt])
  @@map("reputation_history")
}

// Configuración de niveles Madslider
model MadsliderLevel {
  id                String  @id @default(cuid())
  
  level             String  @unique // "VENDEDOR NUEVO", "PLATA", etc.
  color             String  // "ROJO", "NARANJA", etc.
  
  // Requisitos mínimos
  minSales          Int     @default(0) @map("min_sales")
  minDaysAsSeller   Int     @default(0) @map("min_days_as_seller")
  minRevenue        Decimal @default(0) @db.Decimal(15, 2) @map("min_revenue")
  
  // Límites máximos para tasas negativas
  maxClaimRate      Float   @default(1.0) @map("max_claim_rate") // 0.1 = 10%
  maxCancellationRate Float @default(1.0) @map("max_cancellation_rate")
  maxDelayRate      Float   @default(1.0) @map("max_delay_rate")
  
  // Beneficios del nivel
  description       String? @db.Text
  boostDiscount     Float   @default(0) @map("boost_discount") // Porcentaje de descuento en boosts
  
  order             Int     @default(0) // Orden visual
  
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  
  @@map("madslider_levels")
}

model MeliAdsSnapshot {
  id                  String   @id @default(cuid())
  userId              String   @map("user_id")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  metricsDays         Int      @default(14) @map("metrics_days")
  advertisersCount    Int      @default(0) @map("advertisers_count")
  campaignsCount      Int      @default(0) @map("campaigns_count")
  recommendationsCount Int     @default(0) @map("recommendations_count")
  totals              Json?
  deltas              Json?
  diagnostics         Json?
  errors              Json?
  source              String   @default("sync")
  /// Día civil AR (YYYY-MM-DD) para corte guardado una vez por día (`daily_cutoff`).
  bucketDateKey       String?  @map("bucket_date_key")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  campaignRows        MeliAdsCampaignSnapshot[]
  evaluatedChanges    MeliAdsChange[] @relation("MeliAdsChangeEvaluatedSnapshot")

  @@unique([userId, bucketDateKey], map: "meli_ads_snapshots_user_bucket_key")
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, bucketDateKey(sort: Desc)])
  @@map("meli_ads_snapshots")
}

model MeliAdsCampaignSnapshot {
  id             String   @id @default(cuid())
  snapshotId     String   @map("snapshot_id")
  snapshot       MeliAdsSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  campaignId     Int      @map("campaign_id")
  advertiserId   Int      @map("advertiser_id")
  siteId         String   @map("site_id")
  name           String?
  status         String?
  strategy       String?
  budget         Decimal? @db.Decimal(12, 2)
  roasTarget     Float?   @map("roas_target")
  metrics        Json?
  metricsPrev    Json?    @map("metrics_prev")
  trendScore     Float    @default(0) @map("trend_score")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([snapshotId])
  @@index([campaignId, siteId])
  @@map("meli_ads_campaign_snapshots")
}

model MeliAdsChange {
  id                  String   @id @default(cuid())
  userId              String   @map("user_id")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId          Int      @map("campaign_id")
  advertiserId        Int?     @map("advertiser_id")
  siteId              String   @map("site_id")
  recommendationId    String?  @map("recommendation_id")
  recommendationTitle String?  @map("recommendation_title")
  payload             Json
  apiStatus           Int      @default(0) @map("api_status")
  apiOk               Boolean  @default(false) @map("api_ok")
  apiDetail           Json?    @map("api_detail")
  appliedAt           DateTime @default(now()) @map("applied_at")
  outcome             MeliAdsChangeOutcome @default(PENDING)
  outcomeScore        Float?   @map("outcome_score")
  outcomeSummary      String?  @map("outcome_summary")
  evaluatedAt         DateTime? @map("evaluated_at")
  evaluatedSnapshotId String?   @map("evaluated_snapshot_id")
  evaluatedSnapshot   MeliAdsSnapshot? @relation("MeliAdsChangeEvaluatedSnapshot", fields: [evaluatedSnapshotId], references: [id], onDelete: SetNull)

  @@index([userId, appliedAt(sort: Desc)])
  @@index([campaignId, siteId, appliedAt(sort: Desc)])
  @@index([outcome, appliedAt(sort: Desc)])
  @@map("meli_ads_changes")
}

model SellerCollaboratorInvite {
  id          String                         @id @default(cuid())
  ownerUserId String                         @map("owner_user_id")
  owner       User                           @relation("CollaboratorInvitesSent", fields: [ownerUserId], references: [id], onDelete: Cascade)
  email       String
  permissions Json
  token       String                         @unique
  status      SellerCollaboratorInviteStatus @default(PENDING)
  expiresAt   DateTime                       @map("expires_at")
  createdAt   DateTime                       @default(now()) @map("created_at")

  @@index([ownerUserId])
  @@index([ownerUserId, email])
  @@map("seller_collaborator_invites")
}

model SellerCollaborator {
  id           String   @id @default(cuid())
  ownerUserId  String   @map("owner_user_id")
  owner        User     @relation("CollaboratorAccountsOwned", fields: [ownerUserId], references: [id], onDelete: Cascade)
  memberUserId String   @map("member_user_id")
  member       User     @relation("CollaboratorMemberships", fields: [memberUserId], references: [id], onDelete: Cascade)
  permissions  Json
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([ownerUserId, memberUserId])
  @@index([memberUserId])
  @@map("seller_collaborators")
}

// =====================
// SISTEMA DE SOPORTE
// =====================

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_USER
  RESOLVED
  CLOSED
}

enum TicketCategory {
  COMPRAS
  VENTAS
  ENVIOS
  PAGOS
  CUENTA
  RECLAMOS
  OTROS
}

model SupportTicket {
  id          String         @id @default(cuid())
  
