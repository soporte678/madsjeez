# ============================================
# MADSJEEZ MARKETPLACE - Variables de Entorno
# ============================================

# --- JARVIS AI ---
JARVIS_ENABLED=true
JARVIS_INIT_TOKEN=

# --- LLM (Ollama) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=closer-ventas-14b

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- NextAuth ---
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- MercadoPago ---
MERCADOPAGO_ACCESS_TOKEN=

# --- MCP GitHub (REQUERIDO para autonomia del agente) ---
# El token se usa para controlar GitHub via MCP
# Se lee automaticamente del remote de git si esta configurado
# O setear manualmente:
GITHUB_PERSONAL_ACCESS_TOKEN=

# --- MCP Resend (opcional) ---
RESEND_API_KEY=

# --- Voice (opcional) ---
ELEVENLABS_API_KEY=

# --- Railway (opcional) ---
RAILWAY_API_TOKEN=

# --- Meta Pixel + Conversions API (CAPI) ---
# Pixel ID es publico (aparece en HTML). Generar en business.facebook.com/events_manager2.
NEXT_PUBLIC_META_PIXEL_ID=
# Token de Conversions API. NUNCA prefix con NEXT_PUBLIC. Generar en Events Manager > Settings.
META_CAPI_ACCESS_TOKEN=
# Codigo (sin =) del meta tag facebook-domain-verification (Brand Safety > Domains).
META_DOMAIN_VERIFICATION=
# Solo para entornos preview/test — eventos van a "Test Events" sin afectar prod.
META_TEST_EVENT_CODE=
