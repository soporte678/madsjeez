# Supabase — use placeholders only; never commit real keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# Mismo valor que arriba pero sin NEXT_PUBLIC_: obligatorio en Railway/Docker para que el servidor
# (middleware, /api/admin/auth/*) tenga URL y anon key aunque NEXT_PUBLIC_* quedara vacío en build.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
# Obligatorio para login admin (/api/admin/auth/sign-in valida admin_users con rol servicio)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# Opcional: si es URL directa db.*:5432, migrate.mjs la usará cuando DATABASE_URL sea pooler — puede dar P1001 desde IPv4-only; preferí session o dejá vacío y usá la derivación automática.
SUPABASE_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres

# NextAuth — NEXTAUTH_URL debe ser EXACTAMENTE la URL pública que abren los usuarios (http/https + www o apex).
# Si difiere entre www y sin-www, Google OAuth puede fallar con "State cookie was missing" o entrar en loop al login.
# El código intenta derivar dominio compartido automáticamente desde NEXTAUTH_URL.
# Si querés forzarlo explícitamente, definí NEXTAUTH_COOKIE_DOMAIN (ej. .madsjeez.com.ar).
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
# NEXTAUTH_COOKIE_DOMAIN=.madsjeez.com.ar

# Prisma / DB
# En producción `DATABASE_URL` suele ser el pooler Supabase **transaction** (:6543, host *.pooler.supabase.com, usuario postgres.<ref>).
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres
# Opcional para `migrate.mjs`: si no la definís, el script deriva **Supavisor session** (mismo host pooler, puerto 5432) — IPv4-friendly (Railway). Si la definís, que sea la URI **Session mode** del panel Supabase (Connect → Session), no hace falta que sea db.*.
# En Railway: si `DIRECT_DATABASE_URL` apunta a `db.*.supabase.co`, borrala o usá Session; ese host suele dar P1001 desde IPv4-only.
# Forzar derivación antigua a host `db.*:5432` (suele ser IPv6-only desde algunos PaaS): PRISMA_MIGRATE_SUPABASE_USE_DB_HOST=1
# migrate.mjs (20260514i+): P3009/P3018 deriva (access_key, meli oauth, meli ads history, last_catalog_import_at); desactivar: PRISMA_MIGRATE_AUTO_RESOLVE_P3009_DRIFT=0
# DIRECT_DATABASE_URL=

# Stripe (optional)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Mercado Pago
MERCADOPAGO_CLIENT_ID=your_mp_client_id
MERCADOPAGO_CLIENT_SECRET=your_mp_client_secret
MERCADOPAGO_ACCESS_TOKEN=your_mp_access_token
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=your_public_key
MERCADOPAGO_REDIRECT_URI=http://localhost:3000/api/seller/payment-gateway/mercadopago/callback
MERCADOPAGO_WEBHOOK_SECRET=your_webhook_signing_secret

# Zipnova Envíos (cotización en checkout / MP) — https://docs.zipnova.com/envios
# Sin estas variables el envío sigue siendo el monto fijo legacy (2500 ARS) cuando no es gratis.
# Base típica Argentina: https://api.zipnova.com.ar/v2 — Chile: https://api.zipnova.cl/v2 — México: https://api.zipnova.com.mx/v2
ZIPNOVA_API_BASE_URL=https://api.zipnova.com.ar/v2
ZIPNOVA_ACCOUNT_ID=your_numeric_account_id
# Opcional: ID de origen en el address book de Zipnova (si no se define, usa el default de la cuenta)
# ZIPNOVA_ORIGIN_ID=
# Identificador de canal para reglas en Zipnova (máx. 150 caracteres)
ZIPNOVA_SOURCE=madsjeez_marketplace
# Autenticación HTTP Basic: usuario = API token, contraseña = API secret (ver PDF / docs Zipnova)
ZIPNOVA_API_TOKEN=your_api_token
ZIPNOVA_API_SECRET=your_api_secret

# OAuth Zipnova por vendedor (app marketplace registrada en Zipnova; cada vendedor autoriza su cuenta)
# Redirect URI debe coincidir exactamente con la registrada en Zipnova (ej. http://localhost:3000/api/seller/zipnova/oauth/callback)
# ZIPNOVA_OAUTH_BASE_URL=https://api.zipnova.com.ar  (sin /v2; default según región si se omite)
ZIPNOVA_OAUTH_CLIENT_ID=
ZIPNOVA_OAUTH_CLIENT_SECRET=
ZIPNOVA_OAUTH_REDIRECT_URI=http://localhost:3000/api/seller/zipnova/oauth/callback

# Checkout marketplace — fee sobre precio de producto (no sobre envío). Ej. 10 = 10%
MARKETPLACE_SALES_FEE_PERCENT=10
# Si hay cookie mj_affiliate_id válida (perfil Supabase): % sobre subtotal producto que va a escrow interno (no split MP al afiliado)
AFFILIATE_COMMISSION_PERCENT=10

# Mercado Libre — OAuth por usuario (importar ítems + promociones → campañas)
# Creá la app en https://developers.mercadolibre.com.ar/ y registrá el Redirect URI exacto.
MELI_APP_ID=your_meli_app_id
MELI_CLIENT_SECRET=your_meli_client_secret
# Debe coincidir con el redirect configurado en ML Developers (ej. http://localhost:3000/api/meli/oauth/callback)
MELI_REDIRECT_URI=http://localhost:3000/api/meli/oauth/callback
# URL pública HTTPS donde ML envía notificaciones (misma que en Developers → Notificaciones callbacks URL)
# MELI_NOTIFICATIONS_URL=https://www.madsjeez.com.ar/api/meli/notifications

# Opcional: token para scripts CLI (download-meli-images.ts) sin abrir el panel
# MELI_ACCESS_TOKEN=APP_USR-...

# Opcional: MLA (default), MLB, MLM, etc.
# MELI_AUTH_SITE=https://auth.mercadolibre.com.ar
# Firma del parámetro ?state= en OAuth (si no se define, se usa NEXTAUTH_SECRET)
# MELI_OAUTH_STATE_SECRET=generate_with_openssl_rand_base64_32

# Meta / WhatsApp — set in hosting only
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
META_WEBHOOK_VERIFY_TOKEN=random_verify_string_you_define

# OAuth state signing (Mercado Pago seller connect) — NO lo da Mercado Pago; generá un secreto aleatorio (min. 16 chars).
# Ej. PowerShell: [Convert]::ToBase64String([byte[]](1..32 | % { Get-Random -Max 256 }))
# O CMD: powershell -NoProfile -Command "$r = New-Object Security.Cryptography.RNGCryptoServiceProvider; $b = New-Object byte[] 32; $r.GetBytes($b); [Convert]::ToBase64String($b)"
MP_OAUTH_STATE_SECRET=generate_with_openssl_rand_base64_32

# Admin bootstrap (dev/staging only; leave unset in production)
ENABLE_ADMIN_BOOTSTRAP=false
ADMIN_SETUP_SECRET=
ADMIN_CREATE_DIRECT_SECRET=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Analytics 4 — medición en el sitio público (ID tipo G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Opcional: métricas en /admin/analytics vía API (JSON de cuenta de servicio, una sola línea)
# GA4 → Administrador → ID de propiedad numérico (properties/123 → solo 123)
GA4_PROPERTY_ID=
# Pegá el contenido completo del JSON descargado de Google Cloud (sin saltos de línea o como secret multilínea)
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Gemini (optional chat)
GEMINI_API_KEY=
# Si es true, /api/ai/notifications no llama a Gemini y arma avisos desde datos del marketplace (útil sin cuota o para ahorrar requests).
GEMINI_NOTIFICATIONS_DISABLED=
# Límite in-memory por ventana de 15 min (IP anónima / usuario logueado). Ver src/lib/rate-limit-memory.ts.
NOTIFICATIONS_RATE_LIMIT_ANON_MAX=
NOTIFICATIONS_RATE_LIMIT_AUTH_MAX=

PORT=3000
NODE_ENV=development
