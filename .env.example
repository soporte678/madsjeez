# Supabase — use placeholders only; never commit real keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32

# Prisma / DB
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres

# Stripe (optional)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Mercado Pago
MERCADOPAGO_CLIENT_ID=your_mp_client_id
MERCADOPAGO_CLIENT_SECRET=your_mp_client_secret
MERCADOPAGO_ACCESS_TOKEN=your_mp_access_token
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=your_public_key
MERCADOPAGO_REDIRECT_URI=http://localhost:3000/api/seller/payment-gateway/mercadopago/callback
MERCADOPAGO_WEBHOOK_SECRET=your_webhook_signing_secret

# Mercado Libre — OAuth por usuario (importar ítems + promociones → campañas)
# Creá la app en https://developers.mercadolibre.com.ar/ y registrá el Redirect URI exacto.
MELI_APP_ID=your_meli_app_id
MELI_CLIENT_SECRET=your_meli_client_secret
# Debe coincidir con el redirect configurado en ML Developers (ej. http://localhost:3000/api/meli/oauth/callback)
MELI_REDIRECT_URI=http://localhost:3000/api/meli/oauth/callback
# URL pública HTTPS donde ML envía notificaciones (misma que en Developers → Notificaciones callbacks URL)
# MELI_NOTIFICATIONS_URL=https://www.madsjeez.com.ar/api/meli/notifications

# Opcional: MLA (default), MLB, MLM, etc.
# MELI_AUTH_SITE=https://auth.mercadolibre.com.ar
# Firma del parámetro ?state= en OAuth (si no se define, se usa NEXTAUTH_SECRET)
# MELI_OAUTH_STATE_SECRET=generate_with_openssl_rand_base64_32

# Meta / WhatsApp — set in hosting only
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
META_WEBHOOK_VERIFY_TOKEN=random_verify_string_you_define

# OAuth state signing (Mercado Pago seller connect) — NO lo da Mercado Pago; generá un secreto aleatorio (min. 16 chars).
# Ej. PowerShell: [Convert]::ToBase64String([byte[]](1..32 | % { Get-Random -Max 256 }))
# O CMD: powershell -NoProfile -Command "$r = New-Object Security.Cryptography.RNGCryptoServiceProvider; $b = New-Object byte[] 32; $r.GetBytes($b); [Convert]::ToBase64String($b)"
MP_OAUTH_STATE_SECRET=generate_with_openssl_rand_base64_32

# Admin bootstrap (dev/staging only; leave unset in production)
ENABLE_ADMIN_BOOTSTRAP=false
ADMIN_SETUP_SECRET=
ADMIN_CREATE_DIRECT_SECRET=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gemini (optional chat)
GEMINI_API_KEY=

PORT=3000
NODE_ENV=development
