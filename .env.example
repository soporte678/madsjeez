# ============================================
# MADSJEEZ MARKETPLACE - Variables de Entorno
# ============================================

# --- JARVIS AI ---
JARVIS_ENABLED=true
JARVIS_INIT_TOKEN=

# --- LLM (Ollama) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=closer-ventas-14b

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- NextAuth ---
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- MercadoPago ---
MERCADOPAGO_ACCESS_TOKEN=

# --- MCP GitHub (REQUERIDO para autonomia del agente) ---
# El token se usa para controlar GitHub via MCP
# Se lee automaticamente del remote de git si esta configurado
# O setear manualmente:
GITHUB_PERSONAL_ACCESS_TOKEN=

# --- MCP Resend (opcional) ---
RESEND_API_KEY=

# --- Voice (opcional) ---
ELEVENLABS_API_KEY=

# --- Railway (opcional) ---
RAILWAY_API_TOKEN=

# --- Google Maps Platform (geolocalización) ---
# Clave PÚBLICA: restringida por dominio (madsjeez.com.ar). Maps JS + Places New.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID para AdvancedMarkerElement (estilo de mapa en cloud console).
NEXT_PUBLIC_GOOGLE_MAP_ID=
# Clave PRIVADA: solo servidor. Geocoding + Routes API. NUNCA exponer al cliente.
GOOGLE_MAPS_SERVER_API_KEY=

# --- Integraciones de tiendas (conexión directa Tienda Nube) ---
TIENDANUBE_APP_ID=
TIENDANUBE_CLIENT_SECRET=
# Clave para cifrar credenciales de integraciones en reposo (32 bytes hex/base64).
INTEGRATION_ENC_KEY=
