{
  "name": "madsjeez-marketplace",
  "version": "1.0.0",
  "description": "MADSJEEZ Marketplace - Plataforma de comercio electrónico",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "eslint",
    "seo:export-inventory": "node scripts/seo-export-inventory.mjs",
    "migrate:deploy": "prisma migrate deploy",
    "test": "vitest run",
    "migrate:resolve:access-key-applied": "prisma migrate resolve --applied 20260504174800_add_access_key",
    "migrate:resolve:access-key-rolled-back": "prisma migrate resolve --rolled-back 20260504174800_add_access_key",
    "migrate:resolve:meli-oauth-applied": "prisma migrate resolve --applied 20260506120000_add_seller_meli_oauth",
    "migrate:resolve:meli-oauth-rolled-back": "prisma migrate resolve --rolled-back 20260506120000_add_seller_meli_oauth",
    "migrate:resolve:meli-ads-history-applied": "prisma migrate resolve --applied 20260506141500_add_meli_ads_history",
    "migrate:resolve:meli-ads-history-rolled-back": "prisma migrate resolve --rolled-back 20260506141500_add_meli_ads_history",
    "migrate:resolve:last-catalog-import-applied": "prisma migrate resolve --applied 20260506203000_add_last_catalog_import_at",
    "migrate:resolve:last-catalog-import-rolled-back": "prisma migrate resolve --rolled-back 20260506203000_add_last_catalog_import_at",
    "migrate:resolve:meli-multi-account-applied": "prisma migrate resolve --applied 20260518200000_meli_multi_account_sync",
    "migrate:resolve:meli-multi-account-rolled-back": "prisma migrate resolve --rolled-back 20260518200000_meli_multi_account_sync",
    "scrape:aliexpress": "tsx scripts/scrape-aliexpress-images.ts",
    "download:meli-images": "tsx scripts/download-meli-images.ts",
    "download:meli-seller": "tsx scripts/download-meli-seller.ts --store bullservice",
    "download:meli-seller-eco": "tsx scripts/download-meli-seller.ts --store bullservice --resume --eco",
    "optimize:images": "node scripts/optimize-static-images.mjs",
    "backfill:store-slugs": "node scripts/backfill-store-slugs.mjs",
    "flash:provision-driver": "node scripts/provision-flash-driver.mjs",
    "merchant:sync": "node scripts/sync-google-merchant.mjs",
    "ollama:bench": "node scripts/benchmark-ollama-models.mjs",
    "ollama:tunnel": "node scripts/update-ollama-tunnel.mjs",
    "ollama:tunnel:watch": "node scripts/update-ollama-tunnel.mjs --watch",
    "mcp:check": "echo '=== MCP Config ===' && cat .cursor/mcp.json && echo '=== Servers ===' && npx -y @github/mcp-server --version 2>/dev/null || echo 'GitHub MCP: instalando...'",
    "mcp:github": "powershell -ExecutionPolicy Bypass -File scripts/mcp-github-wrapper.ps1",
    "mcp:github:check": "node -e \"const t=process.env.GITHUB_PERSONAL_ACCESS_TOKEN; console.log(t?'Token OK: '+t.slice(0,8)+'...':'Token NO configurado. Setea GITHUB_PERSONAL_ACCESS_TOKEN')\"",
    "mcp:railway": "railway mcp run",
    "mcp:railway:check": "railway whoami 2>/dev/null || echo 'Railway: ejecuta railway login primero'",
    "railway:install": "npm install -g @railway/cli",
    "railway:login": "railway login",
    "railway:status": "railway status",
    "railway:logs": "railway logs",
    "railway:variables": "railway variables",
    "railway:deploy": "railway up",
    "railway:link": "railway link"
  },
