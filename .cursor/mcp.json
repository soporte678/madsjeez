{
  "mcpServers": {
    "railway": {
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "scripts/mcp-railway-wrapper.ps1"],
      "env": {
        "RAILWAY_CLIENT_ID": "rlwy_oaci_cZ8RpvMGJQbwVKXfUKx8ZyDc"
      }
    },
    "supabase": {
      "command": "npx",
      "args": ["-y", "@supabase/mcp-server@latest"],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "",
        "SUPABASE_PROJECT_ID": "",
        "SUPABASE_REGION": "us-east-1"
      }
    },
    "github": {
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "scripts/mcp-github-wrapper.ps1"]
    },
    "resend": {
      "command": "npx",
      "args": ["-y", "resend-mcp"],
      "env": {
        "RESEND_API_KEY": "",
        "SENDER_EMAIL_ADDRESS": "Madsjeez <noreply@madsjeez.com.ar>",
        "REPLY_TO_EMAIL_ADDRESSES": "soporte@madsjeez.com"
      }
    }
  }
}
