{
  "mcpServers": {
    "railway": {
      "url": "https://mcp.railway.com"
    },
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp"
    },
    "github": {
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "scripts/mcp-github-wrapper.ps1"]
    },
    "resend": {
      "command": "npx",
      "args": ["-y", "resend-mcp"],
      "env": {
        "RESEND_API_KEY": "",
        "SENDER_EMAIL_ADDRESS": "Madsjeez <noreply@madsjeez.com.ar>",
        "REPLY_TO_EMAIL_ADDRESSES": "soporte@madsjeez.com"
      }
    }
  }
}
