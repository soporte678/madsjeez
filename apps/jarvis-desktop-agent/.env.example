JARVIS_DESKTOP_ENABLED=true
JARVIS_DESKTOP_PORT=8787
JARVIS_DESKTOP_HOST=127.0.0.1
JARVIS_DESKTOP_SECRET=change-me
# Debe coincidir EXACTAMENTE con JARVIS_DESKTOP_SECRET en Railway (servicio madsjeez)

MARKETPLACE_API_URL=https://www.madsjeez.com.ar
# Opcional: JARVIS_API_SECRET del backend (orquestación remota). NO confundir con JARVIS_DESKTOP_SECRET.
MARKETPLACE_JARVIS_SECRET=

JARVIS_VOICE_PROFILE=atlas
# TTS: edge (neural, recomendado) | windows (legacy)
JARVIS_TTS_PROVIDER=edge
# Voces Edge neural — Atlas ≈ masculino calmado | Nova ≈ femenino fluido
JARVIS_TTS_VOICE_ATLAS=es-AR-TomasNeural
JARVIS_TTS_VOICE_NOVA=es-AR-ElenaNeural
# Ajuste fino opcional: -10% a +10%, pitch -10Hz a +10Hz
# JARVIS_TTS_RATE=-6%
# JARVIS_TTS_PITCH=-4Hz
JARVIS_PUSH_TO_TALK=true
JARVIS_WAKE_WORD_ENABLED=false
JARVIS_READ_ONLY=true
JARVIS_REQUIRE_CONFIRMATION=true

JARVIS_AGENT_TASKS_DIR=../../.agent-tasks
JARVIS_REPO_ROOT=../..

OLLAMA_BASE_URL=http://127.0.0.1:11434
JARVIS_MODEL_FAST=qwen2.5:3b

CURSOR_PATH=
CLAUDE_PATH=
WINDSURF_PATH=
