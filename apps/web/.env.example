# ============================================
# MADSJEEZ Marketplace - Variables de Entorno
# ============================================

# Copiar este archivo a .env.local y completar con tus valores

# ============================================
# SUPABASE (Obligatorio)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publico
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreto

# ============================================
# NEXT.JS
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# PASARELAS DE PAGO (Configurar según necesidad)
# ============================================

# Stripe (Opcional)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# MercadoPago (Opcional)
MERCADOPAGO_PUBLIC_KEY=TEST-...
MERCADOPAGO_ACCESS_TOKEN=TEST-...
MERCADOPAGO_WEBHOOK_SECRET=tu-webhook-secret

# ============================================
# API EXTERNA - MERCADOLIBRE (Referencia)
# ============================================
MELI_APP_ID=tu-app-id
MELI_CLIENT_SECRET=tu-client-secret
MELI_REDIRECT_URI=http://localhost:3000/api/auth/meli/callback

# ============================================
# SERVICIOS ADICIONALES
# ============================================

# SendGrid / Email
SENDGRID_API_KEY=SG.xxx
EMAIL_FROM=noreply@madsjeez.com

# Algolia (para búsqueda avanzada - Opcional)
NEXT_PUBLIC_ALGOLIA_APP_ID=tu-app-id
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=tu-search-key
ALGOLIA_ADMIN_KEY=tu-admin-key

# Cloudflare / CDN (Opcional)
CLOUDFLARE_ZONE_ID=tu-zone-id
CLOUDFLARE_API_TOKEN=tu-api-token

# ============================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ============================================

# Modo de desarrollo
NODE_ENV=development

# Puerto (opcional, por defecto 3000)
PORT=3000

# Configuración de logs
LOG_LEVEL=debug

# ============================================
# SEGURIDAD
# ============================================

# Secret para JWT (generar uno seguro)
JWT_SECRET=tu-secreto-muy-seguro-de-al-menos-32-caracteres

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# ============================================
# FEATURE FLAGS
# ============================================

NEXT_PUBLIC_ENABLE_PAYMENTS=false
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_PROMOTIONS=true
